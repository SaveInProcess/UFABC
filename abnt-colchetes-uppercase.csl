<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="numeric">
  <info>
    <title>ABNT (numérico, colchetes, autores MAIÚSCULAS)</title>
    <id>http://www.zotero.org/styles/abnt-num-colchetes-uppercase</id>
    <link href="http://www.zotero.org/styles/abnt" rel="template"/>
    <author>
      <name>Gerado por Assistente</name>
    </author>
    <category citation-format="numeric"/>
    <category field="generic-base"/>
    <summary>Estilo ABNT numérico com citações entre colchetes e autores em MAIÚSCULAS.</summary>
    <updated>2026-05-20T00:00:00+00:00</updated>
    <rights>CC0</rights>
  </info>

  <macro name="author">
    <names variable="author" delimiter="; ">
      <name form="long" name-as-sort-order="all" initialize-with=". " sort-separator=", ">
        <name-part name="family" text-case="uppercase"/>
        <name-part name="given" form="short" text-case="uppercase"/>
      </name>
    </names>
  </macro>

  <macro name="title">
    <text variable="title" font-style="italic"/>
  </macro>

  <macro name="container">
    <text variable="container-title" font-style="italic"/>
  </macro>

  <macro name="volume_issue_pages">
    <group delimiter=", ">
      <text variable="volume" prefix="v. "/>
      <text variable="issue" prefix="n. "/>
      <text variable="page" prefix="p. "/>
    </group>
  </macro>

  <macro name="issued">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="doi">
    <text variable="doi" prefix="DOI: "/>
  </macro>

  <citation collapse="citation-number">
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography hanging-indent="true" line-spacing="1.0">
    <layout delimiter=". " suffix=".">
      <text macro="author"/>
      <text macro="title"/>
      <group delimiter=", ">
        <text macro="container"/>
        <text macro="volume_issue_pages"/>
      </group>
      <text macro="issued"/>
      <text macro="doi"/>
    </layout>
  </bibliography>

  <locale xml:lang="pt-BR">
    <terms>
      <term name="editor">org.</term>
      <term name="editors">orgs.</term>
    </terms>
  </locale>

</style>
